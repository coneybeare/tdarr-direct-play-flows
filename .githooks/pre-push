#!/bin/sh
# Prevent direct pushes to main. All changes must go through a pull request.

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "ERROR: Direct push to 'main' is not allowed."
    echo "Please create a feature branch and open a pull request:"
    echo ""
    echo "  git checkout -b your-branch-name"
    echo "  git push -u origin your-branch-name"
    echo "  gh pr create"
    echo ""
    exit 1
  fi
done

exit 0
